<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Anchor</AssemblyName>
    <Product>Anchor</Product>
    <Authors>Telesphoreo</Authors>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <!-- A publish names a runtime but not a framework (scripts/build-installer.ps1 runs
       `dotnet publish -r win-x64`, scripts/build-linux-packages.ps1 runs
       `dotnet publish -r linux-x64`), so the runtime picks the one target framework. -->
  <PropertyGroup Condition="'$(TargetFramework)' == '' and $(RuntimeIdentifier.StartsWith('win-'))">
    <TargetFrameworks />
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == '' and $(RuntimeIdentifier.StartsWith('linux-'))">
    <TargetFrameworks />
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AnchorPlatform>Windows</AnchorPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- No dependency on a distro-specific ICU package; the app is English-only. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AnchorPlatform>Linux</AnchorPlatform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Platform\*.cs holds the contracts; each target compiles only its own OS folder. -->
    <Compile Remove="Platform\**" />
    <Compile Include="Platform\*.cs" />
    <Compile Include="Platform\$(AnchorPlatform)\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(AnchorPlatform)' == 'Windows'">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" />
    <!-- The toolkit asks for 4.7.0, which has a known critical vulnerability. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(AnchorPlatform)' == 'Linux'">
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolixBle\SolixBle.csproj" />
  </ItemGroup>

</Project>
